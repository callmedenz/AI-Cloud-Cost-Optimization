# Run in simulation mode (no AWS calls)
USE_SIMULATION=true

# Optional: how often the backend refreshes metrics (seconds)
UPDATE_INTERVAL_SECONDS=300
FRONTEND_ORIGINS=http://localhost:8000

# Required for live/public API access. Never commit the real value.
# API_ACCESS_TOKEN=
# REQUIRE_API_AUTH=false
# Grafana refuses to start until this is set to a non-default secret.
# GRAFANA_ADMIN_PASSWORD=

# Optional AI assistant. Keep keys only in local/hosting secrets.
# Supported providers: deepseek, groq, openrouter. Leave AI_PROVIDER empty
# to use the local rules assistant without external API calls.
# AI_PROVIDER=groq
# AI_MAX_REQUESTS_PER_DAY=20
# AI_MAX_QUESTION_CHARS=500
# AI_MAX_OUTPUT_TOKENS=300
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=your-current-free-model:free

# Recommended: use an AWS CLI profile instead of hardcoding keys
# AWS_PROFILE=default
# AWS_DEFAULT_REGION=ap-south-1

# Not recommended (avoid long-lived keys in files):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

